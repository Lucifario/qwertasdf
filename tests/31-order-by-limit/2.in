CREATE TABLE u (id INTEGER, name TEXT, age INTEGER)
INSERT INTO u VALUES (1, 'Alice', 30)
INSERT INTO u VALUES (2, 'Bob', 25)
INSERT INTO u VALUES (3, 'Cara', 30)
INSERT INTO u VALUES (4, 'Dan', NULL)
INSERT INTO u VALUES (5, 'Eve', 25)

SELECT name, age FROM u ORDER BY age DESC, name DESC
SELECT name FROM u ORDER BY age ASC, name DESC LIMIT 3
SELECT name FROM u ORDER BY rowid DESC LIMIT 2 OFFSET 1